<?xml version="1.0" encoding="UTF-8"?>
<!--
  Upward debris sensor: one depth camera.
  640x480, 30 Hz, 100 deg horizontal field of view, clip 0.2 to 35 m.
  Gazebo sensor frame: +X optical axis, +Y image left, +Z image up.
  Mounted by x500_rescue so that +X points along body +Z.
  Explicit topic: the sensor publishes
    /uav/depth_up/image         gz.msgs.Image (R_FLOAT32, metres)
    /uav/depth_up/camera_info   gz.msgs.CameraInfo
-->
<sdf version='1.9'>
  <model name='depth_cam_up'>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="depth_up_link">
      <inertial>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz><izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="depth_cam_up/visual/housing">
        <geometry><box><size>0.02 0.06 0.03</size></box></geometry>
      </visual>
      <sensor name="depth_up" type="depth_camera">
        <gz_frame_id>depth_up_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.7453293</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>35.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/uav/depth_up/image</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay />
    </link>
  </model>
</sdf>
