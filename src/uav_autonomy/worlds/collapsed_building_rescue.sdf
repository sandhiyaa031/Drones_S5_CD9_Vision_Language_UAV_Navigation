<?xml version="1.0" encoding="UTF-8"?>
<!--
  Collapsed-building search-and-rescue world (project-tracked).

  Derived from the P1 collapsed_building_complex world. Changes:
    * removed the absolute file:///home/... include of rescue_building; that
      model had no <static> tag, so its nine wall links were free rigid bodies
      interpenetrating static geometry, which held the real-time factor at
      about 0.4
    * removed the four legacy 15 m slabs (box1..box4)
    * every remaining structure model is static
  The roof opening, walls, rubble and manikin geometry are unchanged.

  Frames: Gazebo world is ENU (x east, y north, z up). The UAV spawns at the
  world origin, so PX4 local NED (north, east, down) = (world y, world x, -z).

  System plugins (physics, sensors, ApplyLinkWrench, ...) come from PX4's
  gz server.config via GZ_SIM_SERVER_CONFIG_PATH; see docs/runbook.md.
-->
<sdf version="1.9">
  <world name="collapsed_building_rescue">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
<!-- ===== COLLAPSED STRUCTURE ===== -->

    <model name="complex_left_wall">
      <static>true</static>
      <pose>0 4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.3 3</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="complex_right_wall">
      <static>true</static>
      <pose>0 -4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.3 3</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="complex_back_wall">
      <static>true</static>
      <pose>4.0 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.3 3</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior divider with opening -->
    <model name="interior_wall">
      <static>true</static>
      <pose>1.5 2.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 3.4 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 3.4 2.4</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fallen slab -->
    <model name="fallen_concrete_1">
      <static>true</static>
      <pose>-1.5 2.0 0.6 0.05 0.15 0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 1.8 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 1.8 0.4</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="fallen_concrete_2">
      <static>true</static>
      <pose>2.5 -2.0 0.7 -0.1 0.25 -0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 1.6 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 1.6 0.45</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Broken roof slabs leave a camera-visible opening above the manikin. -->
    <model name="collapsed_roof_north">
      <static>true</static>
      <pose>0 1.5 2.75 0.03 -0.04 0.04</pose>
      <link name="slab">
        <collision name="collision"><geometry><box><size>5.0 1.0 0.35</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 1.0 0.35</size></box></geometry>
          <material><ambient>0.38 0.38 0.38 1</ambient><diffuse>0.48 0.48 0.48 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="collapsed_roof_south">
      <static>true</static>
      <pose>0 -1.5 2.88 -0.02 0.05 -0.06</pose>
      <link name="slab">
        <collision name="collision"><geometry><box><size>5.0 1.0 0.35</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 1.0 0.35</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.52 0.52 0.52 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="collapsed_roof_west">
      <static>true</static>
      <pose>-1.8 0 2.82 0.04 0.02 -0.08</pose>
      <link name="slab">
        <collision name="collision"><geometry><box><size>1.4 1.6 0.35</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 1.6 0.35</size></box></geometry>
          <material><ambient>0.36 0.36 0.36 1</ambient><diffuse>0.46 0.46 0.46 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="collapsed_roof_east">
      <static>true</static>
      <pose>2.25 0 2.72 -0.04 0.03 0.06</pose>
      <link name="slab">
        <collision name="collision"><geometry><box><size>0.5 1.6 0.35</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 1.6 0.35</size></box></geometry>
          <material><ambient>0.40 0.40 0.40 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Rubble -->
    <model name="rubble_a">
      <static>true</static>
      <pose>-3.0 2.8 0.45 0.2 0.1 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.0 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.0 0.9</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rubble_b">
      <static>true</static>
      <pose>-2.8 -2.8 0.4 -0.1 0.2 0.7</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.9 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.9 0.8</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rubble_c">
      <static>true</static>
      <pose>3.0 2.8 0.5 0.15 -0.2 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.3 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.3 1.0</size></box></geometry>
        
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static rescue manikin, visible from above through the roof opening. -->
    <model name="survivor_target">
      <static>true</static>
      <pose>1.2 0 0 0 0 0</pose>
      <link name="manikin">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.24</radius><length>1.55</length></cylinder></geometry>
        </collision>
        <visual name="torso">
          <pose>0 0 1.03 0 0 0</pose><geometry><box><size>0.42 0.28 0.68</size></box></geometry>
          <material><ambient>0.95 0.18 0.025 1</ambient><diffuse>1.0 0.28 0.04 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="head">
          <pose>0 0 1.53 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><ambient>0.95 0.68 0.42 1</ambient><diffuse>1.0 0.78 0.54 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="left_arm">
          <pose>0 0.34 1.05 0.12 0 0.18</pose><geometry><box><size>0.18 0.62 0.18</size></box></geometry>
          <material><ambient>0.95 0.18 0.025 1</ambient><diffuse>1.0 0.28 0.04 1</diffuse></material>
        </visual>
        <visual name="right_arm">
          <pose>0 -0.34 1.05 -0.12 0 -0.18</pose><geometry><box><size>0.18 0.62 0.18</size></box></geometry>
          <material><ambient>0.95 0.18 0.025 1</ambient><diffuse>1.0 0.28 0.04 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.12 0.34 0 0 0</pose><geometry><box><size>0.22 0.18 0.68</size></box></geometry>
          <material><ambient>0.015 0.08 0.38 1</ambient><diffuse>0.025 0.16 0.72 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.12 0.34 0 0 0</pose><geometry><box><size>0.22 0.18 0.68</size></box></geometry>
          <material><ambient>0.015 0.08 0.38 1</ambient><diffuse>0.025 0.16 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

</world>
</sdf>
